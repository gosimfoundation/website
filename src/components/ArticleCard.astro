---
import { Image } from 'astro:assets';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  href: string;
  eyebrow?: string;
  title: string;
  description?: string;
  date?: Date;
  readTime?: string;
  /** Optional thumbnail. When absent the row falls back to an arrow glyph. */
  image?: ImageMetadata;
}
const { href, eyebrow, title, description, date, readTime, image } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const dateLabel = date
  ? new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-US', {
      dateStyle: 'medium',
      timeZone: 'UTC',
    }).format(date)
  : undefined;
---

{/* Stacks below sm: inset at 96px the thumbnail left ~230px for the title, which
    wrapped the longer ones to seven lines. Full-bleed above the text costs
    height but keeps the headline readable, which is what the row is for. */}
<a
  href={href}
  class="group flex flex-col gap-4 border-t border-line py-7 transition-colors hover:border-ink sm:flex-row sm:items-start sm:gap-6"
>
  <div class="order-2 min-w-0 sm:order-1 sm:flex-1">
    {
      (eyebrow || dateLabel) && (
        <p class="tech-label flex flex-wrap items-center gap-x-3 gap-y-1 text-muted">
          {eyebrow && <span class="text-coral">{eyebrow}</span>}
          {eyebrow && dateLabel && <span aria-hidden="true">·</span>}
          {dateLabel && <span>{dateLabel}</span>}
          {readTime && <span aria-hidden="true">·</span>}
          {readTime && <span>{readTime}</span>}
        </p>
      )
    }
    <h3 class="mt-3 text-2xl leading-tight font-semibold transition-colors group-hover:text-teal sm:text-[1.75rem]">
      {title}
    </h3>
    {description && <p class="mt-2.5 max-w-2xl leading-relaxed text-muted">{description}</p>}
  </div>

  {
    image ? (
      /* The thumbnail takes the arrow's slot rather than sitting beside it —
         two affordances in one corner crowd the row. Hover still reads as a
         link through the border, the title colour, and the image scale.

         Uncropped 16:9. Most covers are Open AGI Forum title cards with the
         headline burned into the artwork, and every tighter crop tested sliced
         it mid-word; the whole card reads as texture, a fragment reads as a
         mistake.

         alt="" is deliberate: the heading beside it already names the link, so
         describing the picture again would only pad the screen-reader output. */
      <div class="relative order-1 aspect-video w-full shrink-0 overflow-hidden rounded-xl bg-mist sm:order-2 sm:w-40 lg:w-52">
        <Image
          src={image}
          alt=""
          widths={[416, 720]}
          sizes="(max-width: 639px) calc(100vw - 40px), (max-width: 1023px) 160px, 208px"
          format="webp"
          quality={70}
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      </div>
    ) : (
      <svg
        class="order-1 mt-1 h-5 w-5 shrink-0 self-end text-muted transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-teal sm:order-2 sm:self-start"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17 17 7M9 7h8v8" />
      </svg>
    )
  }
</a>
