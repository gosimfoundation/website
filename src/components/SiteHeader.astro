---
import { getLangFromUrl, useTranslations, localizedPath, localeSwitchPaths } from '../i18n/utils';
import LanguagePicker from './LanguagePicker.astro';

interface Props {
  /** Full-bleed hero pages start transparent; content pages start solid. */
  transparent?: boolean;
}
const { transparent = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizedPath('/', lang);

// Nav mirrors the homepage sections (anchor links so they work from any page).
// One array feeds both the desktop bar and the mobile drawer so the two can
// never drift out of sync.
const links = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: localizedPath('/founders', lang), label: t('nav.founders') },
  { href: `${home}#pillars`, label: t('nav.pillars') },
  { href: `${home}#events`, label: t('nav.events') },
  { href: localizedPath('/blog', lang), label: t('nav.stories') },
  { href: `${home}#spotlights`, label: t('nav.spotlights') },
];

const locales = localeSwitchPaths(Astro.url);
---

<header class={`site-header fixed inset-x-0 top-0 z-20 ${transparent ? '' : 'is-solid'}`}>
  {/* The logo/nav gap tightens below sm: the toggle is 16px wider than the
      language picker it replaces there, which pushed the bar past 320px. */}
  <div class="flex min-h-[78px] items-center justify-between gap-3 px-5 py-4 sm:gap-6 sm:px-8 lg:px-[72px]">
    <a href={home} class="shrink-0" aria-label="GOSIM home">
      <img src="/logo.svg" alt="GOSIM" width="112" height="32" class="w-28" />
    </a>

    <nav class="flex items-center gap-4 text-sm sm:gap-6 lg:gap-8">
      {
        links.map((l) => (
          <a href={l.href} class="hidden transition-colors hover:text-teal sm:inline">
            {l.label}
          </a>
        ))
      }

      {/* The picker moves into the drawer below sm — logo + picker + CTA +
          toggle overflows a 390px bar. */}
      <div class="hidden sm:block"><LanguagePicker /></div>

      <a
        href={`${home}#upcoming`}
        class="tech-label inline-flex min-h-[42px] items-center rounded-full bg-lime px-5 py-3 text-ink transition-transform hover:-translate-y-0.5"
      >
        {t('nav.upcoming')}
      </a>

      {/* A <details> disclosure rather than a scripted button: it opens with
          JS disabled, and DOM order already walks focus through the panel and
          back out, so no focus trap is needed. */}
      <details class="mobile-nav sm:hidden">
        <summary
          class="flex min-h-[44px] min-w-[44px] cursor-pointer items-center justify-center rounded-full text-ink transition-colors hover:text-teal"
          aria-label={t('nav.menu')}
          title={t('nav.menu')}
        >
          <span class="nav-bars" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
        </summary>

        <div
          class="absolute inset-x-0 top-full max-h-[calc(100dvh-78px)] overflow-y-auto border-t border-line bg-paper px-5 pt-2 pb-7 shadow-[0_24px_40px_-24px_rgba(16,36,42,0.45)]"
        >
          <nav class="flex flex-col">
            {
              links.map((l) => (
                <a
                  href={l.href}
                  class="border-b border-line py-4 text-lg transition-colors hover:text-teal"
                >
                  {l.label}
                </a>
              ))
            }
          </nav>

          <p class="tech-label mt-6 text-muted">{t('nav.language')}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              locales.map(({ lang: code, label, href, isCurrent }) => (
                <a
                  href={href}
                  hreflang={code}
                  aria-current={isCurrent ? 'true' : undefined}
                  class={`rounded-full border px-4 py-2 text-sm transition-colors ${
                    isCurrent
                      ? 'border-teal bg-teal font-semibold text-paper'
                      : 'border-line text-ink hover:border-ink'
                  }`}
                >
                  {label}
                </a>
              ))
            }
          </div>
        </div>
      </details>
    </nav>
  </div>
</header>

<style>
  .mobile-nav summary {
    list-style: none;
  }
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  /* Three bars that fold into an X once the panel is open. */
  .nav-bars {
    position: relative;
    display: block;
    height: 16px;
    width: 22px;
  }
  .nav-bars span {
    position: absolute;
    right: 0;
    left: 0;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 250ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 160ms ease;
  }
  .nav-bars span:nth-child(1) {
    top: 0;
  }
  .nav-bars span:nth-child(2) {
    top: 7px;
  }
  .nav-bars span:nth-child(3) {
    top: 14px;
  }
  .mobile-nav[open] .nav-bars span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile-nav[open] .nav-bars span:nth-child(2) {
    opacity: 0;
  }
  .mobile-nav[open] .nav-bars span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-bars span {
      transition: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLDetailsElement>('details.mobile-nav');

  if (nav) {
    const summary = nav.querySelector('summary');
    const close = (refocus = false) => {
      if (!nav.open) return;
      nav.removeAttribute('open');
      if (refocus) summary?.focus();
    };

    // Most nav entries are same-page anchors: an open panel would cover the
    // very section the user just jumped to.
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => close()));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close(true);
    });

    document.addEventListener('click', (e) => {
      if (!nav.contains(e.target as Node)) close();
    });

    // The desktop bar takes over at 640px; a panel left open would otherwise
    // linger in the DOM, still open, when the viewport shrinks again.
    window
      .matchMedia('(min-width: 640px)')
      .addEventListener('change', (e) => {
        if (e.matches) close();
      });
  }
</script>
