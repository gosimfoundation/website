---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Article from '../../../components/Article.astro';

// Chinese articles at /zh/blog/<slug>.
export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => data.lang === 'zh' && !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
  );
  // `next` is the next post to read — i.e. the following, older one.
  return posts.map((post, i) => ({
    params: { slug: post.id.split('/').pop() },
    props: { post, next: posts[i + 1] },
  }));
}

const { post, next } = Astro.props;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  ogType="article"
>
  <Article post={post} next={next} />
</BaseLayout>
