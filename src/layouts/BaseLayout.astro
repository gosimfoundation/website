---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  /** When true, the header sits over a full-bleed hero (transparent until scroll). */
  transparentHeader?: boolean;
  /** Social preview image. Pages without one fall back to the site card. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** 'article' for blog posts, 'website' everywhere else. */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'GOSIM — a global home for open-source conferences, stories, and community.',
  transparentHeader = false,
  image,
  imageAlt,
  ogType = 'website',
} = Astro.props;
const lang = getLangFromUrl(Astro.url);

// Social cards are rendered to a fixed 1200x630 so every platform crops them
// the same way, and as JPEG because WebP support across scrapers is uneven.
// Absolute URLs are mandatory here — scrapers do not resolve relative paths.
const social = image
  ? await getImage({
      src: image,
      width: 1200,
      height: 630,
      fit: 'cover',
      format: 'jpeg',
      quality: 82,
    })
  : null;
const ogImage = new URL(social?.src ?? '/og-default.jpg', Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/logo.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="GOSIM" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt ?? title} />
  </head>
  <body>
    <SiteHeader transparent={transparentHeader} />
    <main>
      <slot />
    </main>
    <SiteFooter />

    <script>
      // Add a subtle background to the fixed header once the page scrolls.
      const onScroll = () => document.body.classList.toggle('is-scrolled', window.scrollY > 12);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    </script>

    <script>
      // Staggered scroll reveals (progressive enhancement; CSS handles
      // reduced-motion / no-JS). Lives in the layout, not a single page:
      // `.reveal` is a global style, so anything without this observer
      // running would stay stuck at opacity 0.
      const els = document.querySelectorAll('.reveal');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>

<style is:global>
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(251, 252, 248, 0.72);
    border-bottom: 1px solid rgba(16, 36, 42, 0.08);
    backdrop-filter: blur(18px);
    opacity: 0;
    transition: opacity 220ms ease;
  }
  body.is-scrolled .site-header::before,
  .site-header.is-solid::before {
    opacity: 1;
  }
</style>
